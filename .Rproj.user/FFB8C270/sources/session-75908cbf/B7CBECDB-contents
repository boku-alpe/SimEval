# 2. Funktion zum Einlesen räumlicher Daten

Die Funktion unterstützt:

- `.shp`,
- `.asc`,
- `.ascii`,
- `.tif`,
- `.tiff`.

Shapefiles werden mit `sf` eingelesen. Die Rasterisierung erfolgt mit `raster::rasterize()`.

```{r import-function}
load_spatial_data <- function(
  path,
  template = NULL,
  field = NULL,
  resolution = c(1, 1),
  background = 0,
  resample_method = "bilinear"
) {
  
  if (!file.exists(path)) {
    stop(
      "Die Datei wurde nicht gefunden:\n",
      path
    )
  }
  
  extension <- tolower(
    tools::file_ext(path)
  )
  
  # ----------------------------------------------------------
  # GeoTIFF und ESRI-ASCII-Grid
  # ----------------------------------------------------------
  
  if (
    extension %in% c(
      "tif",
      "tiff",
      "asc",
      "ascii"
    )
  ) {
    
    result <- raster(
      path
    )
    
    if (!is.null(template)) {
      
      compatible <- compareRaster(
        result,
        template,
        extent = TRUE,
        rowcol = TRUE,
        crs = TRUE,
        res = TRUE,
        orig = TRUE,
        rotation = TRUE,
        values = FALSE,
        stopiffalse = FALSE
      )
      
      if (!isTRUE(compatible)) {
        result <- resample(
          result,
          template,
          method = resample_method
        )
      }
    }
    
    return(result)
  }
  
  # ----------------------------------------------------------
  # Shapefile
  # ----------------------------------------------------------
  
  if (extension == "shp") {
    
    shp_sf <- sf::st_read(
      dsn = path,
      quiet = TRUE
    )
    
    shp_sf <- sf::st_make_valid(
      shp_sf
    )
    
    empty_geometry <- sf::st_is_empty(
      shp_sf
    )
    
    if (any(empty_geometry)) {
      shp_sf <- shp_sf[
        !empty_geometry,
      ]
    }
    
    if (nrow(shp_sf) == 0) {
      stop(
        "Das Shapefile enthält keine gültigen Geometrien:\n",
        path
      )
    }
    
    # --------------------------------------------------------
    # Rastervorlage erstellen, falls keine vorhanden ist
    # --------------------------------------------------------
    
    if (is.null(template)) {
      
      shp_sp <- methods::as(
        shp_sf,
        "Spatial"
      )
      
      template <- raster()
      
      extent(template) <- extent(
        shp_sp
      )
      
      res(template) <- resolution
      
      shp_crs <- sf::st_crs(
        shp_sf
      )
      
      if (!is.na(shp_crs)) {
        crs(template) <- shp_crs$wkt
      }
    }
    
    # --------------------------------------------------------
    # CRS des Shapefiles an das Template anpassen
    # --------------------------------------------------------
    
    template_crs <- raster::projection(
      template
    )
    
    shp_crs <- sf::st_crs(
      shp_sf
    )
    
    if (
      !is.null(template_crs) &&
      !is.na(template_crs) &&
      !is.na(shp_crs)
    ) {
      
      shp_sf <- sf::st_transform(
        shp_sf,
        crs = template_crs
      )
    }
    
    shp_sp <- methods::as(
      shp_sf,
      "Spatial"
    )
    
    # --------------------------------------------------------
    # Rasterisierung
    # --------------------------------------------------------
    
    if (is.null(field)) {
      field <- 1
    }
    
    if (
      is.character(field) &&
      !(field %in% names(shp_sp))
    ) {
      stop(
        "Das Attributfeld '",
        field,
        "' wurde nicht gefunden.\n",
        "Verfügbare Felder:\n",
        paste(
          names(shp_sp),
          collapse = ", "
        )
      )
    }
    
    result <- rasterize(
      x = shp_sp,
      y = template,
      field = field,
      background = background
    )
    
    return(result)
  }
  
  stop(
    "Nicht unterstütztes Dateiformat: .",
    extension,
    "\nUnterstützte Formate: ",
    ".shp, .asc, .ascii, .tif und .tiff"
  )
}
```

# 3. Hilfsfunktionen

## 3.1 Raster für die Darstellung vorbereiten

Werte unterhalb des Schwellenwertes werden auf `NA` gesetzt. Dadurch wird beim Plotten nur die tatsächliche Fläche eingefärbt und nicht der gesamte Raster-Extent.

```{r plot-preparation-function}
prepare_plot_raster <- function(
  raster_object,
  threshold
) {
  
  result <- raster_object
  
  values(result) <- ifelse(
    !is.na(values(result)) &
      values(result) >= threshold,
    1,
    NA
  )
  
  return(result)
}
```

