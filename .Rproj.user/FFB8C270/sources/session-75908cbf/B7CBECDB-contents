# 4. Einzelne Simulation

Dieser Abschnitt wird nur ausgeführt, wenn

``` r
analysis_mode <- "single"
```

gesetzt wurde.

```{r single-analysis}
if (analysis_mode == "single") {
  
  # ----------------------------------------------------------
  # Dateien prüfen
  # ----------------------------------------------------------
  
  if (!file.exists(single_reference_path)) {
    stop(
      "Die Referenzdatei wurde nicht gefunden:\n",
      single_reference_path
    )
  }
  
  if (!file.exists(single_simulation_path)) {
    stop(
      "Die Simulationsdatei wurde nicht gefunden:\n",
      single_simulation_path
    )
  }
  
  # ----------------------------------------------------------
  # Referenz laden
  # ----------------------------------------------------------
  
  depo.obs <- load_spatial_data(
    path = single_reference_path,
    field = single_reference_field,
    resolution = c(1, 1),
    background = 0
  )
  
  # ----------------------------------------------------------
  # Simulation laden
  # ----------------------------------------------------------
  
  depo.sim <- load_spatial_data(
    path = single_simulation_path,
    template = depo.obs,
    field = single_simulation_field,
    background = 0
  )
  
  # ----------------------------------------------------------
  # Raster prüfen
  # ----------------------------------------------------------
  
  raster_compatible <- compareRaster(
    depo.obs,
    depo.sim,
    extent = TRUE,
    rowcol = TRUE,
    crs = TRUE,
    res = TRUE,
    orig = TRUE,
    rotation = TRUE,
    values = FALSE,
    stopiffalse = FALSE
  )
  
  if (!isTRUE(raster_compatible)) {
    stop(
      "Referenz- und Simulationsraster sind nicht kompatibel."
    )
  }
  
  # ----------------------------------------------------------
  # Omega-Wert berechnen
  # ----------------------------------------------------------
  
  OmegaResults <- OmegaTeval(
    obs = depo.obs,
    sim = depo.sim,
    thobs = thobs,
    thsim = thsim
  )
  
  # ----------------------------------------------------------
  # Raster für Darstellung vorbereiten
  # ----------------------------------------------------------
  
  depo.obs.plot <- prepare_plot_raster(
    raster_object = depo.obs,
    threshold = thobs
  )
  
  depo.sim.plot <- prepare_plot_raster(
    raster_object = depo.sim,
    threshold = thsim
  )
  
  # ----------------------------------------------------------
  # Omega-Ergebnisse als Tabelle
  # ----------------------------------------------------------
  
  omega_single <- data.frame(
    ID = "Simulation_1",
    alpha = as.numeric(
      OmegaResults$Omega["alpha"]
    ),
    beta = as.numeric(
      OmegaResults$Omega["beta"]
    ),
    gamma = as.numeric(
      OmegaResults$Omega["gamma"]
    ),
    omega = as.numeric(
      OmegaResults$Omega["omega"]
    ),
    stringsAsFactors = FALSE
  )
  
  # Tabelle ausgeben
  print(omega_single)
  
  # Tabelle speichern
  write.csv(
    omega_single,
    file = here::here(
      "results",
      "tables",
      "omega_single.csv"
    ),
    row.names = FALSE
  )
  
  # ----------------------------------------------------------
  # Rasterkarten als PNG speichern
  # ----------------------------------------------------------
  
  save_raster_plot(
    raster_object = depo.obs.plot,
    filename = "01_observed.png",
    title = "Observed",
    colour = "lightblue"
  )
  
  save_raster_plot(
    raster_object = depo.sim.plot,
    filename = "02_simulated.png",
    title = "Simulated",
    colour = "salmon"
  )
  
  save_raster_plot(
    raster_object = OmegaResults$T,
    filename = "03_union_T.png",
    title = "T: Union",
    colour = "grey50"
  )
  
  save_raster_plot(
    raster_object = OmegaResults$X,
    filename = "04_correct_X.png",
    title = "X: Correct",
    colour = "darkgreen"
  )
  
  save_raster_plot(
    raster_object = OmegaResults$O,
    filename = "05_overestimation_O.png",
    title = "O: Overestimation",
    colour = "orange"
  )
  
  save_raster_plot(
    raster_object = OmegaResults$U,
    filename = "06_underestimation_U.png",
    title = "U: Underestimation",
    colour = "purple"
  )
  
  # Gemeinsame Rasterübersicht speichern
  save_raster_overview(
    observed_raster = depo.obs.plot,
    simulated_raster = depo.sim.plot,
    omega_results = OmegaResults,
    filename = "07_all_omega_rasters.png"
  )
}
```

