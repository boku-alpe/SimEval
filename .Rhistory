)
dat.ternary$label <- paste0(
dat.ternary$ID,
"\nOmega = ",
format(
round(
dat.ternary$omega,
3
),
nsmall = 3
),
"\n",
dat.ternary$source_file
)
dat.ternary$source_label <- paste0(
dat.ternary$ID,
" | ",
dat.ternary$source_file
)
ternary_plot <- ggtern(
data = dat.ternary,
aes(
x = beta,
y = alpha,
