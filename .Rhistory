# ------------------------------------------------------------
# Projektpfade
# ------------------------------------------------------------
project_directory <- here::here()
data_directory <- here::here(
"data"
)
script_directory <- here::here(
"scripts"
)
results_directory <- here::here(
"results"
)
plot_directory <- here::here(
"results",
"plots"
)
table_directory <- here::here(
"results",
"tables"
)
# Ergebnisordner automatisch erzeugen
dir.create(
plot_directory,
recursive = TRUE,
showWarnings = FALSE
)
dir.create(
table_directory,
recursive = TRUE,
showWarnings = FALSE
)
# ------------------------------------------------------------
# OmegaTeval.R laden
# ------------------------------------------------------------
omega_script <- here::here(
"scripts",
"OmegaTeval.R"
)
if (!file.exists(omega_script)) {
stop(
"Die Datei 'scripts/OmegaTeval.R' wurde nicht gefunden:\n",
omega_script
)
}
source(omega_script)
if (!exists("OmegaTeval")) {
stop(
"Die Funktion 'OmegaTeval' wurde nicht gefunden. ",
"Bitte prüfen Sie scripts/OmegaTeval.R."
)
}
# ------------------------------------------------------------
# Analysemodus
# ------------------------------------------------------------
#
# "single"   = eine Referenz und eine Simulation
# "multiple" = eine Referenz und mehrere Simulationen
#
analysis_mode <- "multiple"
# ------------------------------------------------------------
# Schwellenwerte
# ------------------------------------------------------------
thobs <- 0.1
thsim <- 0.1
# ------------------------------------------------------------
# Dateipfade für eine einzelne Simulation
# ------------------------------------------------------------
single_reference_path <- here::here(
"data",
"Sattelbach_Deposition_Area_2013.shp"
)
single_simulation_path <- here::here(
"data",
"simulation_01.asc"
)
# Falls Shapefiles verwendet werden, zum Beispiel:
#
# single_reference_path <- here::here(
#   "data",
#   "referenz.shp"
# )
#
# single_simulation_path <- here::here(
#   "data",
#   "simulation_01.shp"
# )
# ------------------------------------------------------------
# Shapefile-Attribute
# ------------------------------------------------------------
#
# NULL oder 1:
#   Binäre Rasterisierung. Innerhalb der Fläche wird 1 gesetzt.
#
# "height", "param" usw.:
#   Werte aus einer Attributspalte des Shapefiles.
#
single_reference_field <- NULL
single_simulation_field <- NULL
# ------------------------------------------------------------
# Mehrere Simulationen ohne Metadatentabelle
# ------------------------------------------------------------
multiple_simulation_paths <- c(
here::here(
"data",
"releaseSattelbach_5a68fcffb6_voellmy_FlowThickness.tif"
),
here::here(
"data",
"releaseSattelbach_529fba6c41_herschelBulkley_FlowThickness.tif"
),
here::here(
"data",
"releaseSattelbach_1627a228ed_bingham_FlowThickness.tif"
),
here::here(
"data",
"releaseSattelbach_bcce094a04_coulomb_FlowThickness.tif"
)
)
multiple_simulation_ids <- c(
"Simulation_1",
"Simulation_2",
"Simulation_3"
)
# Für Rasterdateien NULL verwenden.
# Für Shapefiles entweder 1 oder den Attributfeldnamen eintragen.
multiple_simulation_fields <- list(
NULL,
NULL,
1
)
load_spatial_data <- function(
path,
template = NULL,
field = NULL,
resolution = c(1, 1),
background = 0,
resample_method = "bilinear"
) {
if (!file.exists(path)) {
stop(
"Die Datei wurde nicht gefunden:\n",
path
)
}
extension <- tolower(
tools::file_ext(path)
)
# ----------------------------------------------------------
# GeoTIFF und ESRI-ASCII-Grid
# ----------------------------------------------------------
if (
extension %in% c(
"tif",
"tiff",
"asc",
"ascii"
)
) {
result <- raster(
path
)
if (!is.null(template)) {
compatible <- compareRaster(
result,
template,
extent = TRUE,
rowcol = TRUE,
crs = TRUE,
res = TRUE,
orig = TRUE,
rotation = TRUE,
values = FALSE,
stopiffalse = FALSE
)
if (!isTRUE(compatible)) {
result <- resample(
result,
template,
method = resample_method
)
}
}
return(result)
}
# ----------------------------------------------------------
# Shapefile
# ----------------------------------------------------------
if (extension == "shp") {
shp_sf <- sf::st_read(
dsn = path,
quiet = TRUE
)
shp_sf <- sf::st_make_valid(
shp_sf
)
empty_geometry <- sf::st_is_empty(
shp_sf
)
if (any(empty_geometry)) {
shp_sf <- shp_sf[
!empty_geometry,
]
}
if (nrow(shp_sf) == 0) {
stop(
"Das Shapefile enthält keine gültigen Geometrien:\n",
path
)
}
# --------------------------------------------------------
# Rastervorlage erstellen, falls keine vorhanden ist
# --------------------------------------------------------
if (is.null(template)) {
shp_sp <- methods::as(
shp_sf,
"Spatial"
)
template <- raster()
extent(template) <- extent(
shp_sp
)
res(template) <- resolution
shp_crs <- sf::st_crs(
shp_sf
)
if (!is.na(shp_crs)) {
crs(template) <- shp_crs$wkt
}
}
# --------------------------------------------------------
# CRS des Shapefiles an das Template anpassen
# --------------------------------------------------------
template_crs <- raster::projection(
template
)
shp_crs <- sf::st_crs(
shp_sf
)
if (
!is.null(template_crs) &&
!is.na(template_crs) &&
!is.na(shp_crs)
) {
shp_sf <- sf::st_transform(
shp_sf,
crs = template_crs
)
}
shp_sp <- methods::as(
shp_sf,
"Spatial"
)
# --------------------------------------------------------
# Rasterisierung
# --------------------------------------------------------
if (is.null(field)) {
field <- 1
}
if (
is.character(field) &&
!(field %in% names(shp_sp))
) {
stop(
"Das Attributfeld '",
field,
"' wurde nicht gefunden.\n",
"Verfügbare Felder:\n",
paste(
names(shp_sp),
collapse = ", "
)
)
}
result <- rasterize(
x = shp_sp,
y = template,
field = field,
background = background
)
return(result)
}
stop(
"Nicht unterstütztes Dateiformat: .",
extension,
"\nUnterstützte Formate: ",
".shp, .asc, .ascii, .tif und .tiff"
)
}
prepare_plot_raster <- function(
raster_object,
threshold
) {
result <- raster_object
values(result) <- ifelse(
!is.na(values(result)) &
values(result) >= threshold,
1,
NA
)
return(result)
}
save_raster_plot <- function(
raster_object,
filename,
title,
colour
) {
png(
filename = file.path(
plot_directory,
filename
),
width = 1800,
height = 1400,
res = 200
)
plot(
raster_object,
legend = FALSE,
col = colour,
main = title
)
dev.off()
}
save_raster_overview <- function(
observed_raster,
simulated_raster,
omega_results,
filename = "07_all_omega_rasters.png"
) {
png(
filename = file.path(
plot_directory,
filename
),
width = 2400,
height = 3000,
res = 200
)
old_par <- par(
no.readonly = TRUE
)
on.exit(
par(old_par),
add = TRUE
)
par(
mfrow = c(3, 2),
mar = c(2, 2, 3, 2)
)
plot(
observed_raster,
legend = FALSE,
col = "lightblue",
main = "Observed"
)
plot(
simulated_raster,
legend = FALSE,
col = "salmon",
main = "Simulated"
)
plot(
omega_results$T,
legend = FALSE,
col = "grey50",
main = "T: Union"
)
plot(
omega_results$X,
legend = FALSE,
col = "darkgreen",
main = "X: Correct"
)
plot(
omega_results$O,
legend = FALSE,
col = "orange",
main = "O: Overestimation"
)
plot(
omega_results$U,
legend = FALSE,
col = "purple",
main = "U: Underestimation"
)
dev.off()
}
if (analysis_mode == "multiple") {
# ----------------------------------------------------------
# Eingaben prüfen
# ----------------------------------------------------------
if (
length(multiple_simulation_paths) !=
length(multiple_simulation_ids)
) {
stop(
"Die Anzahl der Simulationspfade und IDs stimmt nicht überein."
)
}
if (
length(multiple_simulation_paths) !=
length(multiple_simulation_fields)
) {
stop(
"Die Anzahl der Simulationspfade und Attributfelder ",
"stimmt nicht überein."
)
}
# ----------------------------------------------------------
# Referenz laden
# ----------------------------------------------------------
if (!file.exists(single_reference_path)) {
stop(
"Die Referenzdatei wurde nicht gefunden:\n",
single_reference_path
)
}
depo.obs <- load_spatial_data(
path = single_reference_path,
field = single_reference_field,
resolution = c(1, 1),
background = 0
)
# ----------------------------------------------------------
# Mehrere Simulationen laden
# ----------------------------------------------------------
n_simulations <- length(
multiple_simulation_paths
)
simulation_layers <- vector(
mode = "list",
length = n_simulations
)
for (i in seq_len(n_simulations)) {
simulation_path_i <- multiple_simulation_paths[i]
simulation_field_i <- multiple_simulation_fields[[i]]
if (!file.exists(simulation_path_i)) {
stop(
"Die Simulationsdatei wurde nicht gefunden:\n",
simulation_path_i
)
}
simulation_layers[[i]] <- load_spatial_data(
path = simulation_path_i,
template = depo.obs,
field = simulation_field_i,
background = 0
)
names(
simulation_layers[[i]]
) <- multiple_simulation_ids[i]
}
# RasterStack erzeugen
depo.sim <- stack(
simulation_layers
)
# ----------------------------------------------------------
# Omega-Ergebnisse vorbereiten
# ----------------------------------------------------------
dat.omega <- data.frame(
ID = names(depo.sim),
alpha = rep(NA_real_, n_simulations),
beta = rep(NA_real_, n_simulations),
gamma = rep(NA_real_, n_simulations),
omega = rep(NA_real_, n_simulations),
stringsAsFactors = FALSE
)
# ----------------------------------------------------------
# Omega für alle Simulationen berechnen
# ----------------------------------------------------------
for (i in seq_len(n_simulations)) {
OmegaResults_i <- OmegaTeval(
obs = depo.obs,
sim = depo.sim[[i]],
thobs = thobs,
thsim = thsim
)
omega_i <- OmegaResults_i$Omega
dat.omega[
i,
c(
"alpha",
"beta",
"gamma",
"omega"
)
] <- as.numeric(
omega_i[
c(
"alpha",
"beta",
"gamma",
"omega"
)
]
)
}
print(dat.omega)
# Ergebnisse speichern
write.csv(
dat.omega,
file = here::here(
"results",
"tables",
"omega_multiple.csv"
),
row.names = FALSE
)
}
