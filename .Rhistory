R = "γ",
colour = "Datenquelle"
) +
theme_bw() +
theme(
legend.position = "right",
plot.title = element_text(
face = "bold"
),
plot.subtitle = element_text(
size = 10
)
)
ggplot2::ggsave(
filename = file.path(
plot_directory,
"08_ternary_multiple_simulations.png"
),
plot = ternary_plot,
width = 12,
height = 9,
units = "in",
dpi = 200
)
print(ternary_plot)
}
